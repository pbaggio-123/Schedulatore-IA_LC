{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/production-scheduler run build",
  "outputDirectory": "artifacts/production-scheduler/dist/public",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
